{
  "name": "math-cards",
  "version": "0.34.0",
  "private": true,
  "description": "Offline Mathematical Expression Atlas",
  "scripts": {
    "build": "python tools/build.py",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "python tools/check.py",
    "check:generated": "python tools/check_generated.py",
    "check:source": "python tools/check_source.py",
    "format": "prettier --write \"src/{legacy-models,inference-*,systems-*,subject-inventory,expansion-*,continuation-*,number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*,distribution-extension*}.js\" \"src/subject-inventory.css\" \"tests/{legacy-provider,inference-*,systems-*,subject-*,expansion-*,continuation-*,number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*,distribution-extension*}.test.mjs\" \"tools/{measure_startup,generated_io}.cjs\" \"tests/generated-io.test.mjs\" \"tests/startup-{runtime,registry,routing,measurement}.test.mjs\"",
    "check:format": "prettier --check \"src/{legacy-models,inference-*,systems-*,subject-inventory,expansion-*,continuation-*,number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*,distribution-extension*}.js\" \"src/subject-inventory.css\" \"tests/{legacy-provider,inference-*,systems-*,subject-*,expansion-*,continuation-*,number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*,distribution-extension*}.test.mjs\" \"tools/{measure_startup,generated_io}.cjs\" \"tests/generated-io.test.mjs\" \"tests/startup-{runtime,registry,routing,measurement}.test.mjs\"",
    "measure:startup": "node tools/measure_startup.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
