{
  "name": "math-cards",
  "version": "0.34.0",
  "private": true,
  "description": "Offline Mathematical Expression Atlas",
  "scripts": {
    "build": "python tools/build.py",
    "test": "node --test --test-concurrency=2 tests/*.test.mjs",
    "check": "python tools/check.py",
    "check:generated": "python tools/check_generated.py",
    "check:source": "python tools/check_source.py",
    "format": "prettier --write \"src/{legacy-models,inference-*,systems-*,subject-inventory,expansion-*,continuation-*}.js\" \"src/{number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*}.js\" \"src/{distribution-extension*,analysis-extension*,discrete-extension*,estimation-extension*,sampling-extension*,design-*,comparison-*}.js\" \"src/subject-inventory.css\" \"tests/{legacy-provider,inference-*,systems-*,subject-*,expansion-*,continuation-*}.test.mjs\" \"tests/{number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*}.test.mjs\" \"tests/{distribution-extension*,analysis-extension*,discrete-extension*,estimation-extension*,sampling-extension*,design-*,comparison-*}.test.mjs\" \"tools/{measure_startup,generated_io,produce_scene_markup}.cjs\" \"tests/generated-io.test.mjs\" \"tests/startup-{runtime,registry,routing,measurement}.test.mjs\" \"tests/release-recovery.test.mjs\" \"tests/roadmap-*.test.mjs\" \"src/{number-extension*,geometry-extension*}.js\" \"tests/{number-extension*,geometry-extension*}.test.mjs\" \"src/{number-insight*,plane-geometry*,spatial-insight*}.js\" \"tests/{number-insight*,plane-geometry*,spatial-insight*}.test.mjs\" \"tests/insight-notation.test.mjs\"",
    "check:format": "prettier --check \"src/{legacy-models,inference-*,systems-*,subject-inventory,expansion-*,continuation-*}.js\" \"src/{number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*}.js\" \"src/{distribution-extension*,analysis-extension*,discrete-extension*,estimation-extension*,sampling-extension*,design-*,comparison-*}.js\" \"src/subject-inventory.css\" \"tests/{legacy-provider,inference-*,systems-*,subject-*,expansion-*,continuation-*}.test.mjs\" \"tests/{number-foundation*,spatial-foundation*,dynamics-extension*,algebra-extension*,algorithm-extension*}.test.mjs\" \"tests/{distribution-extension*,analysis-extension*,discrete-extension*,estimation-extension*,sampling-extension*,design-*,comparison-*}.test.mjs\" \"tools/{measure_startup,generated_io,produce_scene_markup}.cjs\" \"tests/generated-io.test.mjs\" \"tests/startup-{runtime,registry,routing,measurement}.test.mjs\" \"tests/release-recovery.test.mjs\" \"tests/roadmap-*.test.mjs\" \"src/{number-extension*,geometry-extension*}.js\" \"tests/{number-extension*,geometry-extension*}.test.mjs\" \"src/{number-insight*,plane-geometry*,spatial-insight*}.js\" \"tests/{number-insight*,plane-geometry*,spatial-insight*}.test.mjs\" \"tests/insight-notation.test.mjs\"",
    "measure:startup": "node tools/measure_startup.cjs",
    "check:scenes": "python tools/check_scene_markup.py"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
